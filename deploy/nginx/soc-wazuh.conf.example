# Rutas del Wazuh del SOC para un bloque «server» del portal. Copiar a /etc/nginx/snippets/soc-wazuh.conf
# (root, 0600), sustituir __SOC_WAZUH_PROXY_KEY__ por el valor de SOC_WAZUH_PROXY_KEY de
# /etc/soc-portal/portal.env y añadir `include /etc/nginx/snippets/soc-wazuh.conf;` al bloque (install.sh ya lo
# hace). Comprobar con `nginx -t` antes de recargar. En una VM que ya tiene estas rutas escritas en un bloque,
# usar deploy/configurar_wazuh_nginx.sh, que las mueve aquí sin mostrar el secreto.
#
# Nginx pregunta al portal (sesión, doble factor, permiso y ámbito) y pasa al Wazuh Dashboard local la
# identidad, el rol y el espacio que devuelve. Las cabeceras de identidad del navegador se sustituyen siempre.
location = /_soc_wazuh_auth {
    internal;
    proxy_pass http://127.0.0.1:8000/security/wazuh/check/;
    proxy_method GET;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-SOC-Wazuh-Key "__SOC_WAZUH_PROXY_KEY__";
}
location = /wazuh { absolute_redirect off; return 302 /security/wazuh/enter/; }
location /wazuh/ {
    auth_request /_soc_wazuh_auth;
    auth_request_set $soc_wazuh_user $upstream_http_x_soc_wazuh_user;
    auth_request_set $soc_wazuh_roles $upstream_http_x_soc_wazuh_roles;
    auth_request_set $soc_wazuh_tenant $upstream_http_x_soc_wazuh_tenant;
    error_page 401 = @soc_wazuh_login;
    proxy_pass https://127.0.0.1:5602;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/wazuh-dashboard/certs/root-ca.pem;
    proxy_ssl_name wazuh-dashboard;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For 127.0.0.1;
    proxy_set_header Authorization "";
    proxy_set_header X-Proxy-User "";
    proxy_set_header X-Proxy-Roles "";
    proxy_set_header X-SOC-Wazuh-User $soc_wazuh_user;
    proxy_set_header X-SOC-Wazuh-Roles $soc_wazuh_roles;
    proxy_set_header securitytenant $soc_wazuh_tenant;
    proxy_http_version 1.1;
    proxy_read_timeout 90s;
    proxy_buffering off;
    access_log off;
    add_header Cache-Control "no-store, private" always;
}
location @soc_wazuh_login {
    absolute_redirect off;
    return 302 /security/wazuh/enter/;
}
