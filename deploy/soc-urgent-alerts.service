[Unit]
Description=Check Wazuh for urgent SOC customer alerts
After=network-online.target wazuh-indexer.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/soc-portal
EnvironmentFile=/etc/soc-portal/portal.env
ExecStart=/opt/soc-portal-venv/bin/python /srv/soc-portal/manage.py poll_urgent_alerts
# Sin límite, un oneshot colgado bloquea las comprobaciones de cada minuto.
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/soc-portal/data
