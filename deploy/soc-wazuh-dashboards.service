[Unit]
Description=Sync Centro SOC client dashboards into Wazuh
After=wazuh-dashboard.service
# Requisite y no Requires: si el operador para el dashboard por mantenimiento, no lo vuelve a arrancar.
Requisite=wazuh-dashboard.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/soc-portal
ExecStart=/usr/bin/python3 /srv/soc-portal/deploy/sync_wazuh_dashboards.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
