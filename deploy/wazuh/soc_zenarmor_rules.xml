<!-- Keep existing block/security IDs used by reports; add normal receipt for onboarding. -->
<group name="zenarmor,">
  <rule id="110100" level="0">
    <decoded_as>zenarmor</decoded_as>
    <description>Zenarmor event received</description>
  </rule>
  <rule id="110104" level="0">
    <decoded_as>zenarmor-iso</decoded_as>
    <description>Zenarmor ISO timestamp JSON event received</description>
  </rule>
  <rule id="110103" level="3">
    <if_sid>110100,110104</if_sid>
    <field name="ip_src_saddr" type="pcre2">^.+$</field>
    <field name="is_blocked" type="pcre2">^0$</field>
    <description>Zenarmor event from $(ip_src_saddr) to $(ip_dst_saddr).</description>
    <options>no_full_log</options>
  </rule>
  <rule id="110101" level="5">
    <if_sid>110100,110104</if_sid>
    <field name="is_blocked" type="pcre2">^1$</field>
    <description>Zenarmor blocked a connection</description>
    <group>zenarmor_block,</group>
  </rule>
  <rule id="110102" level="8">
    <if_sid>110100,110104</if_sid>
    <field name="is_blocked" type="pcre2">^1$</field>
    <field name="security_tags" type="pcre2">[a-zA-Z]</field>
    <description>Zenarmor blocked a connection with a security category</description>
    <group>zenarmor_block,zenarmor_security,</group>
  </rule>
  <rule id="110105" level="10">
    <if_sid>110100,110104</if_sid>
    <field name="is_blocked" type="pcre2">^0$</field>
    <field name="security_tags" type="pcre2">[a-zA-Z]</field>
    <description>Zenarmor reported a security category without blocking the connection</description>
    <group>zenarmor_security,</group>
  </rule>
</group>
