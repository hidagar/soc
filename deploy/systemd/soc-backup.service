[Unit]
Description=Centro SOC soc-backup
After=network-online.target wazuh-indexer.service wg-quick@wg-soc.service
[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/soc-portal
EnvironmentFile=/etc/soc-portal/portal.env
ExecStart=/opt/soc-portal-venv/bin/python /srv/soc-portal/manage.py operate_soc backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/soc-portal/data /run /var/lib/soc-recovery
UMask=0077
TimeoutStartSec=1800
