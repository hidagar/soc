# PLANTILLA: Django no carga este archivo automáticamente.
# Configuración orientativa de servidor; completar fuera de Git.
SOC_PORTAL_DEBUG=0
SOC_PORTAL_SECRET_KEY=
SOC_PORTAL_ALLOWED_HOSTS=soc.example.org
SOC_PORTAL_CSRF_ORIGINS=https://soc.example.org
SOC_PUBLIC_ORIGIN=https://soc.example.org
SOC_PORTAL_MFA_REQUIRED=1
# Claves Fernet distintas; no son las credenciales de los fabricantes.
SOC_PORTAL_UNIFI_KEY=
SOC_PORTAL_OPNSENSE_KEY=
SOC_PORTAL_SSH_KEY=
SOC_PORTAL_MAIL_KEY=
SOC_WAZUH_PROXY_KEY=
SOC_INDEXER_READER_FILE=/etc/soc-portal/indexer-reader.json
SOC_INDEXER_CA=/etc/wazuh-indexer/certs/root-ca.pem
# Completar solo cuando corresponda al entorno:
# SOC_PORTAL_PUBLIC_SYSLOG_IP=
# SOC_PORTAL_EXTRA_SYSLOG_IPS=
# SOC_GEOIP_DATABASE=
# SOC_ASN_DATABASE=
# No activar SOC_NATIVE_ENGINE_GATE en producción.
